#!/bin/sh
set -eu
umask 077
APP="${TRIM_APPDEST:?missing TRIM_APPDEST}"
VAR="${TRIM_PKGVAR:?missing TRIM_PKGVAR}"
PID="$VAR/quarkdrive.pid"
LOG="$VAR/quarkdrive.log"
BIN="$APP/bin/quarkdrive"
SOCKET="$APP/app.sock"
# TRIM_APPDEST may be a symlink; /proc reports the resolved executable path.
REAL_BIN=$(readlink -f "$BIN" 2>/dev/null || printf '%s' "$BIN")
fail() { printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE:-/dev/null}"; exit 1; }
check() {
  [ -f "$PID" ] || return 1
  id=$(cat "$PID" 2>/dev/null) || return 1
  case "$id" in *[!0-9]*|'') return 1;; esac
  kill -0 "$id" 2>/dev/null || return 1
  [ -r "/proc/$id/exe" ] || return 1
  exe=$(readlink "/proc/$id/exe" 2>/dev/null || true)
  [ "$exe" = "$REAL_BIN" ] || [ "$exe" = "$REAL_BIN (deleted)" ]
}
case "${1:-}" in
start)
  mkdir -p "$VAR"
  if check; then exit 0; fi
  test -x "$BIN" || { echo 'QuarkDrive binary not found' > "${TRIM_TEMP_LOGFILE:-/dev/null}"; exit 1; }
  SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}"
  DOWNLOAD_DIR="${SHARE_PATHS%%:*}"
  if [ -z "$DOWNLOAD_DIR" ]; then
    fail 'fnOS data-share paths are unavailable; check application resource grants'
  fi
  # Resources are provisioned by fnOS, not created by the application with root permissions.
  if [ ! -d "$DOWNLOAD_DIR" ] || [ ! -w "$DOWNLOAD_DIR" ]; then
    echo "Missing or unwritable fnOS data-share directory: $DOWNLOAD_DIR" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
  fi
  unset QUARKDRIVE_DEV
  export QUARKDRIVE_DATA_DIR="$VAR/data"
  export QUARKDRIVE_WEB_DIR="$APP/www"
  export QUARKDRIVE_SOCKET="$SOCKET"
  export QUARKDRIVE_DOWNLOAD_DIR="$DOWNLOAD_DIR"
  cd "$APP"
  nohup "$BIN" >> "$LOG" 2>&1 &
  echo "$!" > "$PID"
  i=0
  while [ "$i" -lt 10 ]; do
    if check && [ -S "$SOCKET" ]; then exit 0; fi
    if ! kill -0 "$(cat "$PID")" 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  if check; then kill -TERM "$(cat "$PID")" 2>/dev/null || true; fi
  rm -f "$PID"
  fail 'QuarkDrive socket did not become ready; inspect application log'
  ;;
stop)
  if check; then
    id=$(cat "$PID")
    kill -TERM "$id" 2>/dev/null || true
    i=0
    while [ "$i" -lt 20 ] && check; do sleep 1; i=$((i+1)); done
    if check; then kill -KILL "$id" 2>/dev/null || true; fi
  fi
  rm -f "$PID" "$SOCKET"
  ;;
status) check && exit 0 || exit 3;;
*) echo "unsupported action: ${1:-missing}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"; exit 1;;
esac
